# 除外設定の詳細: https://help.github.com/articles/ignoring-files/

# 依存パッケージ
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# テスト生成物
/coverage

# Next.js / vinext 生成物
/.next/
/.vinext/
/out/

# その他
.DS_Store
*.pem

# デバッグログ
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.dev-*.log

# 環境変数ファイル（必要な場合のみ明示的に管理対象へ追加）
.env*

# Vercel
.vercel

# TypeScript・ビルド生成物
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
